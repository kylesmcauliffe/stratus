---
import type { RadarChartData } from '@/lib/compare-radar-metrics';

interface Props {
  data: RadarChartData;
}

const { data } = Astro.props;
const { axes, labels } = data;
const n = axes.length;
const cx = 120;
const cy = 120;
const maxR = 88;
const colors = ['#1e5a8a', '#2d7ab8', '#7ec8e8'];

function point(angle: number, r: number): string {
  const rad = ((angle - 90) * Math.PI) / 180;
  return `${cx + r * Math.cos(rad)},${cy + r * Math.sin(rad)}`;
}

function polygonForHospital(hospitalIndex: number): string {
  return axes
    .map((axis, i) => {
      const angle = (360 / n) * i;
      const pct = axis.values[hospitalIndex] ?? 0;
      const r = (pct / 100) * maxR;
      return point(angle, r);
    })
    .join(' ');
}

const gridLevels = [25, 50, 75, 100];
---

<div class="compare-radar mx-auto max-w-md" role="img" aria-label="Radar comparison chart">
  <svg viewBox="0 0 240 240" class="h-auto w-full">
    {
      gridLevels.map((level) => {
        const r = (level / 100) * maxR;
        const pts = Array.from({ length: n }, (_, i) => point((360 / n) * i, r)).join(' ');
        return <polygon points={pts} fill="none" stroke="#e2e8f0" stroke-width="1" />;
      })
    }
    {
      axes.map((_, i) => {
        const angle = (360 / n) * i;
        return (
          <line
            x1={cx}
            y1={cy}
            x2={point(angle, maxR).split(',')[0]}
            y2={point(angle, maxR).split(',')[1]}
            stroke="#e2e8f0"
            stroke-width="1"
          />
        );
      })
    }
    {
      labels.map((_, hi) => (
        <polygon
          points={polygonForHospital(hi)}
          fill={colors[hi % colors.length]}
          fill-opacity="0.15"
          stroke={colors[hi % colors.length]}
          stroke-width="2"
        />
      ))
    }
    {
      axes.map((axis, i) => {
        const angle = (360 / n) * i;
        const [x, y] = point(angle, maxR + 14).split(',').map(Number);
        return (
          <text
            x={x}
            y={y}
            text-anchor="middle"
            dominant-baseline="middle"
            class="fill-brand-gray-700 text-[8px] font-semibold"
          >
            {axis.label}
          </text>
        );
      })
    }
  </svg>
  <ul class="mt-2 flex flex-wrap justify-center gap-3 text-xs">
    {
      labels.map((label, i) => (
        <li class="flex items-center gap-1">
          <span
            class="size-2.5 rounded-sm"
            style={`background-color: ${colors[i % colors.length]}`}
            aria-hidden="true"
          />
          <span class="text-brand-gray-800 font-semibold">{label}</span>
        </li>
      ))
    }
  </ul>
  <p class="text-brand-gray-500 mt-1 text-center text-[0.65rem]">
    Normalized 0–100 per metric across selected hospitals (higher = better on each axis).
  </p>
</div>
