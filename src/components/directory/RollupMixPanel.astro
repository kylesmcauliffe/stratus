---
import type { SystemRollup } from '@/lib/system-rollups';
import MixBarChart from '@/components/directory/MixBarChart.astro';
import PipelineFunnel from '@/components/directory/PipelineFunnel.astro';
import {
  orderPipelineBreakdown,
  orderSalesStageBreakdown,
} from '@/data/pipeline-stage-order';

interface Props {
  rollup: SystemRollup;
}

const { rollup } = Astro.props;
const pipelineOrdered = orderPipelineBreakdown(rollup.pipelineBreakdown);
const stageOrdered = orderSalesStageBreakdown(rollup.salesStageBreakdown);
const hasPipeline = pipelineOrdered.length > 0;
const hasStage = stageOrdered.length > 0;
---

{
  (hasPipeline || hasStage) && (
    <div
      class="rollup-mix-panel border-brand-gray-200 rounded-md border bg-white px-2 py-1.5"
      data-rollup-mix-panel
    >
      <div class="mb-1 flex flex-wrap items-center justify-between gap-1">
        <p class="text-brand-gray-800 text-[0.65rem] font-bold">Rainfall pipeline</p>
        <div class="flex gap-0.5" role="tablist" aria-label="Pipeline visualization">
          <button
            type="button"
            class="rollup-mix-view-btn text-brand-blue rounded px-1.5 py-0.5 text-[0.6rem] font-bold"
            data-view="funnel"
            aria-selected="true"
          >
            Funnel
          </button>
          <button
            type="button"
            class="rollup-mix-view-btn text-brand-gray-600 rounded px-1.5 py-0.5 text-[0.6rem] font-semibold"
            data-view="mix"
            aria-selected="false"
          >
            Mix
          </button>
        </div>
      </div>

      <div class="rollup-mix-view" data-rollup-view="funnel">
        <div class:list={['grid gap-2', hasPipeline && hasStage ? 'grid-cols-2' : 'grid-cols-1']}>
          {hasPipeline && (
            <PipelineFunnel title="Pipeline" rows={pipelineOrdered} id="pipeline-funnel" />
          )}
          {hasStage && (
            <PipelineFunnel title="Sales stage" rows={stageOrdered} id="stage-funnel" />
          )}
        </div>
      </div>

      <div class="rollup-mix-view hidden" data-rollup-view="mix">
        <div class:list={['grid gap-2', hasPipeline && hasStage ? 'grid-cols-2' : 'grid-cols-1']}>
          {hasPipeline && (
            <MixBarChart title="Pipeline" rows={rollup.pipelineBreakdown} id="pipeline-mix" />
          )}
          {hasStage && (
            <MixBarChart title="Sales stage" rows={rollup.salesStageBreakdown} id="stage-mix" />
          )}
        </div>
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll('[data-rollup-mix-panel]').forEach((root) => {
    const buttons = root.querySelectorAll('.rollup-mix-view-btn');
    const views = root.querySelectorAll('[data-rollup-view]');
    const activate = (view) => {
      buttons.forEach((btn) => {
        const on = btn.dataset.view === view;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.classList.toggle('text-brand-blue', on);
        btn.classList.toggle('font-bold', on);
        btn.classList.toggle('text-brand-gray-600', !on);
        btn.classList.toggle('font-semibold', !on);
      });
      views.forEach((v) => {
        const show = v.dataset.rollupView === view;
        v.classList.toggle('hidden', !show);
      });
    };
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        if (view) activate(view);
      });
    });
  });
</script>
