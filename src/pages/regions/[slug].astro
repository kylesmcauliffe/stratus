---
import DirectoryLayout from '@/layouts/DirectoryLayout.astro';
import SystemRollupCards from '@/components/directory/SystemRollupCards.astro';
import DirectoryHospitalTable from '@/components/directory/DirectoryHospitalTable.astro';
import { directoryFilterRegionUrl } from '@/lib/directory-links';
import { directoryRegions, getRegionBySlug } from '@/lib/region-rollups';
import RegionStateNav from '@/components/directory/RegionStateNav.astro';
import RollupVsNationalStrip from '@/components/directory/RollupVsNationalStrip.astro';
import TeamStateMap from '@/components/TeamStateMap.astro';
import { buildStateMapEntries } from '@/lib/state-map-data';

export function getStaticPaths() {
  return directoryRegions().map((r) => ({
    params: { slug: r.slug },
  }));
}

const { slug } = Astro.params;
const region = getRegionBySlug(slug!);

if (!region) {
  return Astro.redirect('/');
}

const { name, hospitals, rollup } = region;
const sorted = [...hospitals].sort((a, b) => {
  const ar = a.teamRankByCjr ?? 9999;
  const br = b.teamRankByCjr ?? 9999;
  if (ar !== br) return ar - br;
  return a.name.localeCompare(b.name);
});

const filterHref = directoryFilterRegionUrl(name);
const stateMapRows = buildStateMapEntries();
const emphasisStates = [...new Set(hospitals.map((h) => h.state))].sort();
const title = `${name} — TEAM hospitals`;
const description = `${hospitals.length} CMS TEAM hospitals in the ${name} region.`;
---

<DirectoryLayout title={title} description={description}>
  <div class="site-container py-3 md:py-4">
    <nav class="text-brand-gray-600 mb-4 text-sm">
      <a href="/" class="text-brand-blue hover:underline">Directory</a>
      <span aria-hidden="true"> / </span>
      <a href="/states#regions" class="text-brand-blue hover:underline">Regions</a>
      <span aria-hidden="true"> / </span>
      <span>{name}</span>
    </nav>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-brand-blue mb-1 text-xl font-bold tracking-tight md:text-2xl">{name}</h1>
        <p class="text-brand-gray-700 text-sm">{description}</p>
        <p class="text-brand-gray-600 mt-1 text-[0.65rem]">
          Pick a state in the sidebar to drill down without leaving {name}.
        </p>
      </div>
      <a
        href={filterHref}
        class="text-brand-blue border-brand-gray-200 hover:bg-brand-sky shrink-0 rounded-button border bg-white px-4 py-2.5 text-sm font-semibold"
      >
        Filter directory →
      </a>
    </div>

    <div class="grid gap-2 lg:grid-cols-[minmax(9rem,11rem)_minmax(0,1fr)] lg:items-start">
      <RegionStateNav regionName={name} regionSlug={slug!} hospitals={hospitals} />
      <div class="min-w-0">
        <RollupVsNationalStrip groupLabel={name} rollup={rollup} />
        <SystemRollupCards rollup={rollup} hospitals={hospitals} regionSlug={slug} peerLabel="national" />
        <div class="border-brand-gray-200 mb-2 rounded-card border bg-brand-gray-50/60 p-3">
          <h2 class="text-brand-blue mb-2 text-sm font-bold">National context</h2>
          <p class="text-brand-gray-500 mb-2 text-[0.65rem]">
            {emphasisStates.length} states in {name} highlighted · click a state for its profile
          </p>
          <TeamStateMap
            states={stateMapRows}
            compact
            emphasisStates={emphasisStates}
            linkMode="profile"
          />
        </div>
        <DirectoryHospitalTable hospitals={sorted} />
      </div>
    </div>
  </div>
</DirectoryLayout>
