---
import DirectoryLayout from '@/layouts/DirectoryLayout.astro';
---

<DirectoryLayout title="Page Not Found" showSourceBar={false}>
  <section class="py-20 text-center">
    <div class="mx-auto max-w-md px-4">
      <p class="text-brand-blue text-6xl font-bold">404</p>
      <h1 class="text-brand-blue mt-4 text-2xl font-bold">Page not found</h1>
      <a href="/" class="text-brand-blue mt-6 inline-block font-semibold hover:underline">
        Back to Hospital Directory
      </a>
    </div>
  </section>
</DirectoryLayout>
