{
  "expo": {
    "name": "Stratus",
    "slug": "stratus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stratus",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rainfallhealth.stratus"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2b72e6",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.rainfallhealth.stratus"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#eef4ff"
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
