# Canonical site URL baked into sitemap and metadata at build time.
SITE=https://rainfall-aeo.netlify.app

# Census API key for county demographics (free): https://api.census.gov/data/key_signup.html
# Required for: npm run fetch:county-demographics
# CENSUS_API_KEY=

# Optional: override Ask API base (defaults to same origin /api/ask on Netlify)
# EXPO_PUBLIC_ASK_API_URL=https://rainfall-aeo.netlify.app
