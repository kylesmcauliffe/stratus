{
  "name": "stratus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "description": "Rainfall Stratus — internal TEAM hospital battle cards (Expo)",
  "scripts": {
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "fetch:team-roster": "node scripts/fetch-team-roster.mjs",
    "synth:tracker": "node scripts/synth-tracker-from-index.mjs",
    "export:tracker-csv": "node scripts/export-tracker-csv.mjs",
    "prepare:tracker": "node scripts/prepare-master-tracker.mjs",
    "refresh:data:live": "npm run fetch:team-roster && npm run fetch:public-data && npm run build:directory-index && npm run prepare:tracker && npm run fetch:county-demographics && npm run build:directory-index",
    "prestart": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/data/hospital-directory-index.json')||JSON.parse(fs.readFileSync('src/data/hospital-directory-index.json')).hospitals.length<50) process.exit(1)\" 2>/dev/null || npm run seed:demo",
    "preweb": "node -e \"const fs=require('fs'); if(!fs.existsSync('src/data/hospital-directory-index.json')||JSON.parse(fs.readFileSync('src/data/hospital-directory-index.json')).hospitals.length<50) process.exit(1)\" 2>/dev/null || npm run seed:demo",
    "start": "expo start",
    "dev": "expo start --web",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export -p web",
    "build:staging": "SITE=https://rainfall-aeo.netlify.app npm run build",
    "typecheck": "tsc --noEmit",
    "sync:team-roster": "node scripts/sync-team-roster-from-csv.mjs",
    "import:rainfall-tracker": "node scripts/import-rainfall-tracker.mjs",
    "fetch:public-data": "node scripts/fetch-hospital-public-data.mjs",
    "fetch:county-demographics": "node scripts/fetch-county-demographics.mjs",
    "fetch:cbsa-demographics": "node scripts/fetch-cbsa-demographics.mjs",
    "build:directory-index": "node scripts/build-directory-index.mjs",
    "fetch:external-context": "node scripts/fetch-external-context.mjs",
    "refresh:data": "npm run sync:team-roster && npm run import:rainfall-tracker && npm run fetch:public-data && npm run fetch:county-demographics && npm run fetch:cbsa-demographics && npm run build:directory-index"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@netlify/functions": "^5.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~57.0.4",
    "expo-print": "~15.0.7",
    "expo-router": "~57.0.8",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.28.0",
    "openai": "^6.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "xlsx": "^0.18.5"
  }
}
